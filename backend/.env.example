PORT=5000
NODE_ENV=development
# Skip Firebase only on this development API; startup refuses this flag outside development.
DEV_AUTH_ENABLED=true
# Optional: change the local identity to try a separate account. Firebase accounts are never linked.
DEV_AUTH_EMAIL=developer@fable.local
DEV_AUTH_NAME=Local developer
FRONTEND_URL=http://localhost:3000
# The API runs on your computer and connects to the Docker database on loopback.
# Replace YOUR_POSTGRES_PASSWORD with root .env's POSTGRES_PASSWORD (URL-encode it).
DATABASE_URL=postgresql://fable:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/fable?schema=fable_development&connection_limit=5&pool_timeout=10&socket_timeout=15
# Local PostgreSQL has no external pooler, so migrations use the same database.
DIRECT_DATABASE_URL=postgresql://fable:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/fable?schema=fable_development
# A future remote database requires TLS and deliberate runtime/migration roles.
FIREBASE_PROJECT_ID=
# Prefer Application Default Credentials / managed identity; never commit service-account keys.
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Optional local development emulator; refused when NODE_ENV=production:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Set only to the exact trusted reverse-proxy hop count when deployed behind one:
# TRUST_PROXY_HOPS=1
# Local-first WebRTC: empty means LAN peers only. Add your own STUN/TURN endpoints
# for other networks. This value is delivered only to authenticated participants.
WEBRTC_ICE_SERVERS=[]
