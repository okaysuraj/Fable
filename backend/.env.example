PORT=5000
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Neon Connect dialog: pooling ON for normal API queries, OFF for migrations and realtime.
# Keep both URLs on the same branch/database. All remote connections verify certificates.
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@ep-REPLACE_WITH_ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&sslaccept=strict&connection_limit=5&pool_timeout=10&socket_timeout=15&connect_timeout=15
DIRECT_DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@ep-REPLACE_WITH_ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&sslaccept=strict&connect_timeout=15
# Preserve the existing application's schema during import. URLs without schema use this value.
DATABASE_SCHEMA=fable_development
# Only for the one-time data-preserving import. The API never falls back to this URL.
LOCAL_DATABASE_URL=
LOCAL_DATABASE_CONTAINER=fable_postgres
# Optional: npm run db:roles:setup creates restricted app/realtime credentials and saves this name.
DATABASE_RUNTIME_ROLE=
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
# Copy the same project's Admin SDK JSON into this ignored, backend-only directory.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/firebase-admin.json
# Alternatively use workload identity (leave the path blank), or injected credentials below.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# For an injected private key, preserve escaped \n inside quotes.
# Never put Admin credentials in EXPO_PUBLIC_* or VITE_* variables.
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
# Optional local development emulator; refused when NODE_ENV=production:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Set only to the exact trusted reverse-proxy hop count when deployed behind one:
# TRUST_PROXY_HOPS=1
# Local-first WebRTC: empty means LAN peers only. Add your own STUN/TURN endpoints
# for other networks. This value is delivered only to authenticated participants.
WEBRTC_ICE_SERVERS=[]

# New media is private disk storage for local development. Never serve this directory statically.
MEDIA_STORAGE_DRIVER=disk
MEDIA_STORAGE_PATH=./data/media
# A single self-hosted server can explicitly use disk with an absolute persistent path.
# It requires off-host backups; multiple API machines must use shared private object storage.
MEDIA_STORAGE_DURABILITY=
# Otherwise production uses s3. An operator-owned S3-compatible server is supported.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_FORCE_PATH_STYLE=false
# Leave blank when using the hosting platform's workload identity.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# The API runs its durable worker locally. For a separate worker: false + npm run worker.
WORKER_EMBEDDED=true
# Optional realtime role on the same direct Neon endpoint. Defaults to the direct host with app credentials.
EVENT_DATABASE_URL=
# Optional CA file for a private PostgreSQL certificate authority. Certificate verification stays enabled.
DATABASE_TLS_CA_PATH=
# Direct Apple push transport; key files stay outside source control. FCM uses Firebase Admin above.
APNS_BUNDLE_ID=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_PATH=
# Alternatively inject APNS_KEY_P8 as a multiline secret environment variable.

# Operator-owned coturn: comma-separated turn:/turns: URLs. No public relay is used by default.
TURN_URLS=
# At least 32 random characters, shared only by this API and coturn. Never EXPO_PUBLIC_.
TURN_SHARED_SECRET=
# all permits direct paths; relay keeps peers connected through your TURN server.
CALL_ICE_POLICY=all

# Optional group calling. Install the mediasoup native worker with npm rebuild mediasoup.
# Use one API process for media ownership; route /api/group-calls to this process.
SFU_ENABLED=false
SFU_SINGLE_PROCESS=false
SFU_ANNOUNCED_ADDRESS=
SFU_LISTEN_IP=0.0.0.0
SFU_MIN_PORT=40000
SFU_MAX_PORT=40100
