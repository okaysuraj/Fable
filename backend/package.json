{
  "name": "fable-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx src/worker.ts",
    "media:migrate": "tsx src/migrateMedia.ts",
    "sfu:install": "npm rebuild mediasoup",
    "calls:setup": "node scripts/selfhost-calls.mjs setup",
    "calls:relay": "node scripts/selfhost-calls.mjs relay",
    "calls:stop": "node scripts/selfhost-calls.mjs stop",
    "calls:check": "node scripts/check-calling.mjs",
    "selfhost:prepare": "node scripts/selfhost-calls.mjs server",
    "selfhost:help": "node scripts/selfhost-calls.mjs help",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts config",
    "format:check": "prettier --check src scripts config",
    "check": "npm run format:check && npm run prisma:validate && npm run build",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "node scripts/deploy-database.mjs",
    "prisma:deploy": "node scripts/deploy-database.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate:neon": "node scripts/migrate-to-neon.mjs",
    "db:roles:setup": "node scripts/secure-database-access.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "mediasoup": "^3.30.1",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "prettier": "3.9.10",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
