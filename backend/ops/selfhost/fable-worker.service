[Unit]
Description=Fable durable notifications and media maintenance
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fable
Group=fable
WorkingDirectory=/opt/fable/backend
EnvironmentFile=/etc/fable/api.env
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/fable
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
