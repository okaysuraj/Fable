# Requires DEV_AUTH_ENABLED=true on the API; release bundles always use Firebase.
EXPO_PUBLIC_DEV_AUTH_ENABLED=true
# Set all development auth flags to false to restore Firebase locally.
# Leave blank to use Expo's development host automatically.
# For a physical device, you can set http://YOUR_COMPUTER_LAN_IP:5000/api.
# Signed release builds require an explicit HTTPS API URL.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Enable Email/Password and Google in Firebase Authentication's sign-in providers.
# OAuth client of type Web, in the same Firebase/Google Cloud project (not an Android client ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS OAuth client; the app config derives and registers its reversed URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Register ANDROID_APPLICATION_ID and debug/release/Play signing SHA-1 fingerprints in that project.
# After setting these values, rebuild the native app. Google sign-in does not run in Expo Go.
# Set EXPO_PUBLIC_DEV_AUTH_ENABLED=false here and DEV_AUTH_ENABLED=false in backend/.env for Firebase.
# Development only; never set in release builds:
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Configure owned identifiers and your Expo project before a native release.
IOS_BUNDLE_IDENTIFIER=
ANDROID_APPLICATION_ID=
EAS_PROJECT_ID=
