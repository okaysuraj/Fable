# Leave blank to use Expo's development host automatically.
# For a physical device, you can set http://YOUR_COMPUTER_LAN_IP:5000/api.
# Signed release builds require an explicit HTTPS API URL.
EXPO_PUBLIC_API_URL=
# Public Web app configuration from the same Firebase project used by the API.
# Placeholder values keep sign-in disabled until replaced. Admin credentials belong only in backend/.env.
EXPO_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
EXPO_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
EXPO_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_WEB_APP_ID
# Enable Email/Password and Google in Firebase Authentication's sign-in providers.
# OAuth client of type Web, in the same Firebase/Google Cloud project (not an Android client ID).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
# iOS OAuth client; the app config derives and registers its reversed URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=REPLACE_WITH_GOOGLE_IOS_CLIENT_ID
# Register ANDROID_APPLICATION_ID and debug/release/Play signing SHA-1 fingerprints in that project.
# After setting these values, rebuild the native app. Google sign-in does not run in Expo Go.
# Development only; never set in release builds:
# EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Android defaults to the registered com.fable package in app.json.
# Set ANDROID_APPLICATION_ID only when using a separately registered app variant.
# Configure the iOS identifier and your Expo project before a native release.
IOS_BUNDLE_IDENTIFIER=
ANDROID_APPLICATION_ID=
EAS_PROJECT_ID=
# Android FCM uses your Firebase project's native config; this is a local path or an EAS file variable.
# Its package name must match ANDROID_APPLICATION_ID. Rebuild after adding or changing it.
GOOGLE_SERVICES_JSON=
