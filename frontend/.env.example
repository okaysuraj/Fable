# Same Firebase project as the mobile client and backend Admin SDK.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Vite proxies /api to the manually started backend at http://localhost:5000.
VITE_API_URL=/api
# Development only: connect to an actual Firebase Auth Emulator.
VITE_FIREBASE_AUTH_EMULATOR_URL=
