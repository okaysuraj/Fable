{
  "name": "fable",
  "private": true,
  "scripts": {
    "format": "prettier --write backend/src frontend/src mobile/src scripts",
    "format:check": "prettier --check backend/src frontend/src mobile/src scripts",
    "check": "node scripts/check.mjs",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "dev:mobile": "npm --prefix mobile start",
    "build:api": "npm --prefix backend run build",
    "build:web": "npm --prefix frontend run build"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
